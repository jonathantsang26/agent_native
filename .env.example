# Local development: skip sign-in (never on a public deployment).
# AUTH_DISABLED=true

# The agent's model. Or connect Builder.io from the agent sidebar instead.
# ANTHROPIC_API_KEY=

# Production needs a hosted Postgres and a stable auth secret.
# DATABASE_URL=
# BETTER_AUTH_SECRET=

# Live SAM 3.1 outlines on drone frames (Drones → Live).
# MODEL_API_KEY=
# Daily spend cap for SAM outlines in USD (default 5, never above 25).
# SAM_DAILY_BUDGET_USD=5
# Spend is tracked in Upstash Redis; any prefix works (e.g. from the Vercel Marketplace).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Local runs only: track SAM spend in memory instead of Upstash.
# SAM_BUDGET_LOCAL=1

# Custom health check message
PING_MESSAGE=pong
